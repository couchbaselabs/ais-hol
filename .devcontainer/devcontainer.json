{
    "name": "Python AI Workshop",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.black-formatter",
                "couchbase.vscode-couchbase",
                "TheNuProjectContributors.vscode-nushell-lang",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                },
                "[javascript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "[javascriptreact]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                },
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },
    "forwardPorts": [5000, 5173],
    "portsAttributes": {
        "5000": { "label": "Backend (FastAPI)" },
        "5173": { "label": "Frontend (Vite)" }
    },
    "postCreateCommand": "cd frontend && npm install && cd ../backend && pip install -r requirements.txt && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && . $HOME/.cargo/env && cargo install --git https://github.com/couchbaselabs/couchbase-shell.git --tag v1.1.0 --locked"
}
