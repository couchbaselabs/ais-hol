# Mock environment — no real API keys or Couchbase cluster needed.
# Start the mock server first:  python mock_openai.py
# Then start the main backend:  uvicorn main:app --reload --port 5000

# ── LLM / Embeddings ────────────────────────────────────────────────────────
EMBEDDING_MODEL_BASE_URL=http://localhost:9999/v1
EMBEDDING_MODEL_API_KEY=mock-key
INFERENCE_MODEL_BASE_URL=http://localhost:9999/v1
INFERENCE_MODEL_API_KEY=mock-key
EMBEDDING_MODEL=mock-embedding
INFERENCE_MODEL=mock-gpt-4o-mini

# ── Couchbase ────────────────────────────────────────────────────────────────
# The mock Couchbase service (mock_couchbase.py) runs on port 9998.
# All KV, N1QL, and vector-search calls are intercepted and return stub data.
COUCHBASE_CONNECTION_STRING=couchbases://localhost
COUCHBASE_USERNAME=mock
COUCHBASE_PASSWORD=mock
COUCHBASE_BUCKET_NAME=shared
COUCHBASE_SEARCH_INDEX_NAME=documentation

# ── Conversation history ─────────────────────────────────────────────────────
COUCHBASE_CONVERSATION_SCOPE=_default
COUCHBASE_CONVERSATION_COLLECTION=conversations

# ── Semantic cache ───────────────────────────────────────────────────────────
CACHE_BUCKET=semantic_cache
CACHE_SCOPE=_default
CACHE_COLLECTION=semantic
CACHE_INDEX=semantic_cache_vector_idx

# ── Agent Catalog ────────────────────────────────────────────────────────────
AGENT_CATALOG_CONN_STRING=couchbases://localhost
AGENT_CATALOG_USERNAME=mock
AGENT_CATALOG_PASSWORD=mock
AGENT_CATALOG_BUCKET=shared

# ── FAQ search agent ─────────────────────────────────────────────────────────
FAQ_CATALOG_COLLECTION=faq_catalog
FAQ_SIMILARITY_THRESHOLD=0.75

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
MOCK_MODE=true
