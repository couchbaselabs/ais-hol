# Exercise 1
OPENAI_API_KEY=your_openai_api_key_here

# Exercise 3 — Couchbase connection
COUCHBASE_CONNECTION_STRING=couchbases://your-cluster-endpoint
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password
COUCHBASE_BUCKET_NAME=shared
COUCHBASE_SEARCH_INDEX_NAME=documentation

# Exercise 4 — Conversation history (optional, defaults shown)
COUCHBASE_CONVERSATION_SCOPE=_default
COUCHBASE_CONVERSATION_COLLECTION=conversations

# Exercise 5 — Semantic cache (optional, defaults shown)
CACHE_BUCKET=semantic_cache
CACHE_SCOPE=_default
CACHE_COLLECTION=semantic

# Server
PORT=5000
