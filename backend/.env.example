# Exercise 1
OPENAI_API_KEY=your_openai_api_key_here
# Optional: set to use an OpenAI-compatible endpoint (e.g. Capella AI Model Service)
# OPENAI_BASE_URL=https://your-capella-model-service-endpoint/v1
# Optional: override the default model names
# OPENAI_COMPLETION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Exercise 3 — Couchbase connection
COUCHBASE_CONNECTION_STRING=couchbases://your-cluster-endpoint
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password
COUCHBASE_BUCKET_NAME=shared
COUCHBASE_SEARCH_INDEX_NAME=documentation

# Exercise 4 — Conversation history (optional, defaults shown)
COUCHBASE_CONVERSATION_SCOPE=_default
COUCHBASE_CONVERSATION_COLLECTION=conversations

# Exercise 5 — Semantic cache (optional, defaults shown)
CACHE_BUCKET=semantic_cache
CACHE_SCOPE=_default
CACHE_COLLECTION=semantic

# Exercise 6 — Agent Catalog (multi-agent)
AGENT_CATALOG_CONN_STRING=couchbases://your-cluster-endpoint
AGENT_CATALOG_USERNAME=your-username
AGENT_CATALOG_PASSWORD=your-password
AGENT_CATALOG_BUCKET=shared

# Exercise 7 — FAQ search agent
FAQ_CATALOG_COLLECTION=faq_catalog
FAQ_SIMILARITY_THRESHOLD=0.75

# Server
PORT=5000
